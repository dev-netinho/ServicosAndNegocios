# Copie para application-local.properties (gitignored) e ajuste para o banco da sua equipa/ambiente.

spring.datasource.url=jdbc:postgresql://SEU_HOST:5432/SEU_BANCO?sslmode=require
spring.datasource.username=SEU_USUARIO
spring.datasource.password=SUA_SENHA

# --- CONFIGURAÇÃO JWT ---
# Use uma chave aleatória Base64 no seu application-local.properties
api.security.token.secret=INSIRA_UMA_CHAVE_BASE64_LONGA_AQUI
api.security.token.expiration=7200000
